# Copy to .env.local (git-ignored) and change what you need. All optional.

# Where the KYRA backend is. Leave empty: when the backend serves this UI (http://localhost:3000/Kyra-UI-V1/)
# and in `npm run dev` (which forwards /api to KYRA_BACKEND) the API is on the same origin.
VITE_KYRA_API_URL=

# Where `npm run dev` forwards /api. Change if the backend runs on another port.
KYRA_BACKEND=http://localhost:3000

# "backend" (default): the backend's camera captures the visitor and this UI shows its preview.
# "browser": this browser's webcam takes the photo and uploads it (a UI on a different machine).
VITE_CAMERA_SOURCE=backend

# Kiosk token for local development only (apiToken in backend/.runtime/secrets.json). On the mirror,
# open the link `npm run links` prints in the backend instead: it hands the token over in the URL #.
VITE_KYRA_TOKEN=

# Where the app is served. Keep /Kyra-UI-V1/ for the backend and GitHub Pages.
VITE_BASE=/Kyra-UI-V1/

# "true" turns on the shop demo: products with prices, the cart, filters, checkout and piece edits, and
# the cart and filter buttons in the header. Its prices, sizes, brands and stock are made up
# (src/data/shopPlaceholders.js) until a real product feed exists, so leave it off (the default) on a
# mirror that real visitors use. Rebuild after changing it (npm run build).
VITE_SHOP_DEMO=false
