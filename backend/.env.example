# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.2
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Reasoning effort for text calls ("" to omit). Made no measurable difference for gpt-5.2 here.
OPENAI_REASONING_EFFORT=low
# gpt-image input_fidelity. Empty (default) = not sent. "high" keeps faces closer to the photo but costs about
# 2.5x per image (~10,900 input tokens: about $0.15 instead of $0.06). Dropped automatically if the model rejects it.
OPENAI_INPUT_FIDELITY=
OPENAI_TIMEOUT_MS=120000
# Point at another OpenAI-compatible server, e.g. the free rehearsal mock: http://127.0.0.1:4010/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Retries for rate limits (429), server errors (5xx), timeouts and network errors
OPENAI_MAX_RETRIES=3

# --- Network & access ---
# 127.0.0.1 = only this machine can call the API. Use 0.0.0.0 only if the frontend runs on another
# device, and then always set API_TOKEN.
HOST=127.0.0.1
PORT=3000
# Every /api request needs "Authorization: Bearer <token>" or "x-api-key: <token>" (GET may use ?token=).
# Left empty, both tokens are generated on first start and kept in RUNTIME_DIR/secrets.json (owner-only).
# Give "apiToken" to the kiosk and "operatorToken" only to the people running the mirror; the operator token
# is needed for calibration (and its reset) and /api/v2/metrics. "off" disables a token (development only).
API_TOKEN=
OPERATOR_TOKEN=
# Requests must be addressed to localhost, HOST, PUBLIC_BASE_URL's host or one of these names (comma-
# separated). Anything else is refused, which stops DNS rebinding. Add the mirror's LAN name or IP here
# if phones or another screen reach it by a name that is not PUBLIC_BASE_URL's.
ALLOWED_HOSTS=
# The event stream without ?sessionId= carries no visitor images or share links (session). "all" restores
# the old behaviour for a frontend that cannot pass ?sessionId= yet. The operator token always sees all.
EVENT_STREAM_IMAGES=session
# Comma-separated allowed origins, or * for any. Default: localhost/127.0.0.1 on any port + Tauri.
CORS_ORIGINS=
# Max paid requests per window (0 disables): per visitor session for session actions, per client
# address for everything else (so visitors sharing one kiosk do not share one allowance)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# --- Jobs & sessions ---
TRYON_JOB_TIMEOUT_MS=180000
# How long finished try-on jobs stay in memory (they stay pollable from disk until retention)
JOB_TTL_MINUTES=10
# How long a style session (photo + profile for "show me another") lives after its last use
SESSION_TTL_MINUTES=15

# --- Quality & face checks ---
# Reject style-me photos that do not show the whole body
REQUIRE_FULL_BODY=true
# Compare the generated face with the original photo and regenerate if it drifted
FACE_CHECK=true
FACE_CHECK_MIN_SCORE=0.7
FACE_CHECK_RETRIES=1
# Mirror (v2): the face comes from the visit's clearest close-up, placed locally after the render, so by
# default the model gets no face image (+~190 tokens if true) and a weak face never triggers a new image.
RENDER_FACE_REFERENCE=false
RENDER_RETRIES=0

# --- Mirror pipeline (v2) ---
SIDECAR_URL=http://127.0.0.1:8765
SIDECAR_TOKEN=
# auto = start ../sidecar/.venv when the sidecar is not already running; true / false
SIDECAR_SPAWN=auto
SIDECAR_DIR=sidecar
# End the session (and forget the visitor) when the camera sees they have left
AUTO_END_ON_LEAVE=true
# When the camera reports the visitor gone (the sidecar's ABSENT_AFTER_MS, 10 s), the kiosk asks "Still
# here?" for this long before the visit ends: back in view, or "Still here", keeps it. 0 ends it at once.
LEAVE_GRACE_MS=30000
# Max image renders running at once; further requests queue with a position. Raise it if your OpenAI
# image rate limit allows: in the load test, 20 simultaneous visitors waited ~7 min at 2 and ~3 min at 6.
RENDER_CONCURRENCY=2
# Streamed preview images per render (0-3). Each adds ~100 output tokens; 0 = none (default).
PARTIAL_IMAGES=0
# false (default) = render a look only when the visitor asks (a look rendered ahead costs ~2,700 tokens even
# if never seen); dwell = render the next look once the visitor has looked at the current one for
# PREFETCH_DWELL_MS and is still there; auto = whenever the queue is idle; true = always
PREFETCH_OPTIONS=false
PREFETCH_DWELL_MS=10000
PREFETCH_BUDGET_FRACTION=0.5
# Per-look token budget: optional extras (drafts, face-check retries, early designs) only run if the look
# stays under this. 4500 fits a design plus a medium image but not a second image. 0 = no limit.
LOOK_TOKEN_BUDGET=4500
# A low-quality draft alongside the final image (only if it fits the token rule, which it normally doesn't).
RENDER_DRAFT=false
DRAFT_QUALITY=low
# medium by default (about $0.06 an image): low-quality renders looked too rough in real use. low = about $0.02.
FINAL_QUALITY=medium
# A/B test of the final image quality, e.g. low,medium (medium looks break the token rule).
FINAL_QUALITY_EXPERIMENT=
# Design outfits from the camera's early profile, before the photo is taken (~5 s faster first idea). Off by
# default: an early design is wasted (~900 tokens) whenever the visitor leaves before the photo.
EARLY_DESIGN=false
EARLY_DESIGN_MAX=1
# Likes needed for an undertone before liked colours lead its palette and order its looks
LEARN_MIN_RATINGS=20
# Skin measurement in the sidecar: detector (the vendored undertone detector, default) or legacy.
UNDERTONE_ENGINE=detector
# Legacy undertone thresholds (CIELAB hue angle, degrees), used only with UNDERTONE_ENGINE=legacy.
# The detector is tuned with `npm run tune-thresholds -- --save` instead.
SKIN_COOL_MAX_HUE=50
SKIN_WARM_MIN_HUE=58
# Visitors must tick consent before capture (their photo is sent to OpenAI)
REQUIRE_CONSENT=true
# Restart the spawned sidecar if its camera stops reporting for this long
SIDECAR_WATCHDOG_MS=20000
# Send the clothing mask to the image model. gpt-image-1.5 ignores the prompt with a mask, so off.
RENDER_MASK=false

# --- Spend cap ---
# Every call is charged its real cost from OpenAI's token usage (priced per token in src/lib/usage.js;
# override with PRICES_JSON). The COST_* values are only pre-call estimates used to check a call fits.
# Measured 6 Nov 2026: design ~$0.010, final image ~$0.058-0.065, draft ~$0.019. 0 budget = no cap.
DAILY_BUDGET_USD=30
COST_TEXT_CALL_USD=0.02
COST_IMAGE_USD=0.065
COST_DRAFT_IMAGE_USD=0.02
# A budget.warning event and log line when spend passes this share of the cap
BUDGET_WARN_FRACTION=0.8
RUNTIME_DIR=.runtime

# --- Camera (passed to the sidecar) ---
# Which camera: 0 is the first (the built-in one on a laptop); an iPhone or USB camera is usually 1.
CAMERA_INDEX=0
# A camera mounted on its side or upside down: clockwise turn applied to every frame (0, 90, 180, 270).
# Turned 90 degrees on its side, it needs 90 or 270, and which one depends on the direction it was turned:
# don't guess. Stand facing the camera with the backend running and run `npm run camera-check -- --apply`.
CAMERA_ROTATION=0
# Show the picture as a mirror image (like a real mirror). Keep on for the mirror.
CAMERA_MIRROR=true

# --- Storage & privacy ---
# Paths are relative to the project folder (one level above backend/)
ARTIFACTS_DIR=How do I look
WARDROBE_DIR=wardrobe
# v1 debug copies of visitor photos and results, deleted after this many hours. 0 = never written.
RETENTION_HOURS=0
# "Take it home" looks: kept this many hours behind an unguessable link. 0 disables keeping.
KEEP_HOURS=24
# Base URL phones use to open kept looks (default http://HOST:PORT, https with TLS). Keeping looks is
# refused when this is plain http:// on a network address (visitors' photos would travel unencrypted),
# unless ALLOW_INSECURE_LOOKS=true.
PUBLIC_BASE_URL=
ALLOW_INSECURE_LOOKS=false
# The consent screen's "Scan to know more about how your information is used" QR code. Set it to the
# venue's privacy notice. Empty: the QR opens this backend's /privacy page (needs PUBLIC_BASE_URL, so
# phones can reach it); with neither, the consent screen shows no QR.
PRIVACY_URL=

# --- Product photos (Suggestions flat lay, Suggestion to buy, cart) ---
# A studio photo of each designed piece (no person in it; only the design's text goes to OpenAI), made the
# first time a piece is shown and kept in PRODUCT_PHOTO_DIR for every later visitor. About $0.01-0.02 per
# new piece at low quality. Off: the kiosk shows each piece as its colour and category icon instead.
PRODUCT_PHOTOS=true
PRODUCT_PHOTO_QUALITY=low
# PRODUCT_PHOTO_DIR=.runtime/product-photos

# --- Rate and changes ---
# The venue's location, for the weather on the "Rate my outfit" greeting (Open-Meteo, free, no key; only
# these coordinates are sent). Empty: the greeting shows the date and time only.
VENUE_LAT=
VENUE_LON=

# --- Kiosk UI (the team's Kyra-UI-V1) ---
# The built UI (cd Kyra-UI-V1 && npm run build) is served at FRONTEND_PATH: open http://localhost:PORT/Kyra-UI-V1/
# (npm run links prints it with the token). Relative to the project folder. Empty = don't serve a UI.
FRONTEND_DIR=Kyra-UI-V1/dist
FRONTEND_PATH=/Kyra-UI-V1/
# Serve over HTTPS (needed for phones on the venue network): paths to PEM files
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Operations ---
# Alerts (budget warning, camera errors, sidecar crashes, repeated render or session failures, backend
# crashes) go to the log, and to this Slack-compatible incoming webhook (POST {"text": ...}) when set.
ALERT_WEBHOOK_URL=
ALERT_NAME=KYRA mirror
# The same alert is sent at most once per this many minutes
ALERT_COOLDOWN_MINUTES=15
# Daily log files (kyra-YYYY-MM-DD.log), relative to backend/. Empty = stdout only.
LOG_DIR=.runtime/logs
LOG_RETENTION_DAYS=14
# On SIGTERM/SIGINT: refuse new work and wait this long for paid renders already running
SHUTDOWN_GRACE_MS=30000

# --- Finishing renders (camera sidecar) ---
# Paste the visitor's real hands back, and squeeze the render's body outline to theirs. Off by default: on a
# webcam capture (visitor small in frame) both caused artifacts (skin blocks at the wrists, sliced sleeves,
# stepped trouser edges). Turn on only with a sharp camera close to the visitor.
COMPOSE_HANDS=false
COMPOSE_SILHOUETTE=false

# --- KYRA AI NFC Tags (nfc/README.md) ---
# "Would you like a Kyra Tag?" after "I'm done": a Raspberry Pi + PN532 writes the visit's short link
# (NFC_PUBLIC_BASE_URL/s/<token>) to a blank NFC tag. Off by default; the kiosk only offers it while a tag
# writer is polling.
NFC_TAGS=false
# The tag writer's credential (its /etc/kyra-nfc.env has the same value). Not the kiosk token: openssl rand -hex 32
NFC_DEVICE_TOKEN=
# The address written on tags, reachable by phones over HTTPS (e.g. https://kyra.style). Empty: PUBLIC_BASE_URL,
# else this machine (tags then only work on this network).
NFC_PUBLIC_BASE_URL=
# Characters in a link token (8-32)
NFC_TOKEN_LENGTH=10
# How long a tag's Canvas stays up (hours; instead of KEEP_HOURS for visits that took a tag)
NFC_KEEP_HOURS=720
# A tag job not finished in this long fails (seconds)
NFC_JOB_TIMEOUT_S=180
