# The Kyra Tag writer's settings (config.py). Copy to /etc/kyra-nfc.env, chmod 600, fill in the token.
KYRA_BACKEND_URL=http://kyra-mirror.local:3000
# The same value as the backend's NFC_DEVICE_TOKEN. Not the kiosk token. Never commit it.
NFC_DEVICE_TOKEN=
NFC_DEVICE_ID=kyra-tag-writer-1
# i2c | spi | uart: how the PN532 is wired (and its mode switches set)
NFC_INTERFACE=i2c
NFC_SPI_CS_PIN=D5
NFC_UART_PORT=/dev/serial0
# both | issue | read
NFC_MODE=both
NFC_ALLOWED_HOSTS=kyra.style
# Reading mode with a screen attached, e.g.: chromium-browser --kiosk {url}
NFC_DISPLAY_COMMAND=
NFC_POLL_SECONDS=2
NFC_TAG_WAIT_SECONDS=90
NFC_DEBOUNCE_SECONDS=3
NFC_MOCK=false
